# Copie este arquivo para ".env" e preencha com os dados do seu banco.
# O .env está no .gitignore: suas senhas não vão para o GitHub.

# Driver do banco: sqlite | mysql | pgsql
DB_DRIVER=sqlite

# --- SQLite (mais fácil para testar localmente) ---
# Caminho relativo à raiz do projeto
DB_SQLITE_PATH=storage/pdv.sqlite

# --- MySQL / PostgreSQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pdv
DB_USER=root
DB_PASS=

# Alternativa para PostgreSQL na nuvem (Neon): cole a URL de conexão inteira.
# Se DATABASE_URL estiver preenchida, ela tem prioridade sobre DB_HOST/DB_PORT/...
# DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb"

# Fuso horário usado nas datas das vendas
APP_TIMEZONE=America/Cuiaba
